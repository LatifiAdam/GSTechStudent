# ============================================================
# GSTech Docker deployment
# Copy this file to .env on the server.
# DO NOT commit .env to Git.
# ============================================================

MYSQL_DATABASE=gestion_stagiaires
MYSQL_USER=gstech
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
CORS_ORIGIN=*
PORT=3000

BOOTSTRAP_SUPERADMIN_EMAIL=bootstrap@gstech.ma
BOOTSTRAP_SUPERADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD
BOOTSTRAP_SUPERADMIN_ACCESS_LEVEL=technical

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

UPLOAD_DIR=/app/uploads
ABSENCE_ALERT_THRESHOLD=3

# Object storage (S3-compatible / MinIO)
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://object-storage:9000
STORAGE_ACCESS_KEY=gstech-minio
STORAGE_SECRET_KEY=change-this-minio-password
STORAGE_BUCKET=gstech
STORAGE_REGION=us-east-1
STORAGE_FALLBACK_LOCAL=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
