# ============================================================
# GSTech - Ubuntu Server / Docker Compose
# DO NOT COMMIT THIS FILE TO GIT
# ============================================================

MYSQL_DATABASE=gestion_stagiaires
MYSQL_USER=gstech
MYSQL_PASSWORD=CHANGE_THIS
MYSQL_ROOT_PASSWORD=CHANGE_THIS

JWT_SECRET=CHANGE_THIS
CORS_ORIGIN=*
PORT=3000

BOOTSTRAP_SUPERADMIN_EMAIL=bootstrap@gstech.ma
BOOTSTRAP_SUPERADMIN_PASSWORD=CHANGE_THIS
BOOTSTRAP_SUPERADMIN_ACCESS_LEVEL=technical

# Firebase / FCM - optional
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local/legacy upload compatibility
UPLOAD_DIR=/app/uploads
ABSENCE_ALERT_THRESHOLD=3

# ============================================================
# Object Storage - MinIO / S3
# ============================================================
STORAGE_DRIVER=s3
# IMPORTANT:
# "object-storage" is the Docker Compose service name.
STORAGE_ENDPOINT=http://object-storage:9000
STORAGE_ACCESS_KEY=gstech-minio
STORAGE_SECRET_KEY=CHANGE_THIS
STORAGE_BUCKET=gstech
STORAGE_REGION=us-east-1
# Keep old local files readable if necessary
STORAGE_FALLBACK_LOCAL=true
# MinIO ports exposed by Docker
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001