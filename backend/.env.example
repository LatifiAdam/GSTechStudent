# Application
NODE_ENV=production
PORT=3000
CORS_ORIGIN=*

# MySQL (Docker service name)
DB_HOST=mysql
DB_PORT=3306
DB_USER=gstech
DB_PASSWORD=change_this_password
DB_NAME=gestion_stagiaires

# Authentication
JWT_SECRET=generate_a_long_random_secret_here

# Firebase Cloud Messaging (optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# File storage inside the backend container
UPLOAD_DIR=/app/uploads

# Absence alert threshold
ABSENCE_ALERT_THRESHOLD=3

# Temporary first-login Super Admin
BOOTSTRAP_SUPERADMIN_EMAIL=bootstrap@gstech.ma
BOOTSTRAP_SUPERADMIN_PASSWORD=ChangeMe!123456
BOOTSTRAP_SUPERADMIN_ACCESS_LEVEL=technical
